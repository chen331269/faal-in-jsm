+// ---------------------------------------------------------------------------
+// Light three-sample smoothing for the forwarded stick, for games that read the
+// raw stick and implement flick stick themselves without any filtering.
+//
+// Deliberately simple: the filter advances once per *new stick sample*, not once
+// per tick. The controller reports at ~250 Hz while this runs at 1 kHz, so a
+// per-tick filter would apply four times per sample and behave four times harder
+// than intended. Between samples the output is held.
+//
+// The three directions are averaged as unit vectors, which handles the wrap at
+// +/-180 degrees correctly and leaves the deflection untouched.
+// ---------------------------------------------------------------------------
+static float s_filtX[3] = { 1.f, 1.f, 1.f };
+static float s_filtY[3] = { 0.f, 0.f, 0.f };
+static int s_filtCount = 0;
+static float s_filtLastX = -999.f, s_filtLastY = -999.f;
+static float s_filtAngle = 0.f;
+static bool s_filtValid = false;
+bool g_smoothNativeFlickStick = false; // opt-in: per-game behaviour, off by default
+
+static void smoothNativeFlickStick(float &stickX, float &stickY, float dt)
+{
+	float len = sqrtf(stickX * stickX + stickY * stickY);
+	if (len < 0.05f)
+	{
+		s_filtValid = false;
+		s_filtCount = 0;
+		return;
+	}
+
+	// Only advance on a genuinely new reading.
+	bool newSample = (stickX != s_filtLastX) || (stickY != s_filtLastY);
+	if (newSample)
+	{
+		s_filtLastX = stickX;
+		s_filtLastY = stickY;
+
+		float ux = stickX / len;
+		float uy = stickY / len;
+		if (!s_filtValid)
+		{
+			s_filtX[0] = s_filtX[1] = s_filtX[2] = ux;
+			s_filtY[0] = s_filtY[1] = s_filtY[2] = uy;
+			s_filtCount = 0;
+			s_filtValid = true;
+		}
+		else
+		{
+			s_filtX[2] = s_filtX[1];
+			s_filtY[2] = s_filtY[1];
+			s_filtX[1] = s_filtX[0];
+			s_filtY[1] = s_filtY[0];
+			s_filtX[0] = ux;
+			s_filtY[0] = uy;
+			if (s_filtCount < 2)
+				s_filtCount++;
+		}
+
+		// Circular mean of the available samples.
+		int n = s_filtCount + 1;
+		float sx = 0.f, sy = 0.f;
+		for (int i = 0; i < n; i++)
+		{
+			sx += s_filtX[i];
+			sy += s_filtY[i];
+		}
+		if (fabsf(sx) + fabsf(sy) > 1e-6f)
+			s_filtAngle = atan2f(sy, sx);
+	}
+
+	if (!s_filtValid)
+		return;
+
+	stickX = len * cosf(s_filtAngle);
+	stickY = len * sinf(s_filtAngle);
+}

+// Pre-filtering for PS_MOTION: the game receives the raw gyro and applies its own
+// space transform, so FAAL has to run *before* that transform. We evaluate JSM's
+// PLAYER_TURN mapping here instead, filter those two scalars, and fold the result
+// back into the 3D vector.
+//
+// Both directions are homogeneous: the delivered yaw is linear in (Y,Z) and the
+// delivered pitch is linear in X, so multiplying (Y,Z) by s scales the game's yaw
+// by exactly s, and multiplying X by s_p scales its pitch by exactly s_p — without
+// having to replicate the game's math.
+static bool g_faalPsMotion = true;
+
+static void faalPlayerSpace2D(float rx, float ry, float rz, float gx, float gy, float gz,
+  float &outYaw, float &outPitch)
+{
+	float len = sqrtf(gx * gx + gy * gy + gz * gz);
+	float ny = 0.f, nz = 0.f;
+	if (len > 0.f)
+	{
+		ny = gy / len;
+		nz = gz / len;
+	}
+	float w = ny * ry + nz * rz;
+	float s = (w < 0.f) ? -1.f : 1.f;
+	float yz = sqrtf(ry * ry + rz * rz);
+	const float yawRelaxFactor = 2.f; // same 60 degree buffer as the PLAYER_TURN block
+	outYaw = s * fminf(fabsf(w) * yawRelaxFactor, yz);
+	outPitch = -rx;
+}
+
+bool do_FAAL_PSMOTION()
+{
+	g_faalPsMotion = !g_faalPsMotion;
+	if (g_faalPsMotion)
+		COUT << "FAAL PS_MOTION pre-filter ON (player space, per-axis)\n";
+	else
+		COUT << "FAAL PS_MOTION pre-filter OFF (calibrated gyro passed through)\n";
+	return true;
+}

+	           "drop=%g curve=%g peakmin=%g suppressThr=%g freezeMul=%g driftthr=%g drift_on=%d\n",
+	  p.hystRiseTime, p.hystFallTime, p.peakDecayTime, p.driftHoldTimeSec,

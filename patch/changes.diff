+// ---------------------------------------------------------------------------
+//  Per-frame trace (optional, off by default).
+//  Records the filter INPUT and the parameters actually in force that frame,
+//  plus the raw 3D signal it was derived from, so a real play session can be
+//  replayed offline and re-projected into any gyro space.
+//  Cost while recording: one branch + a 68 byte store per frame.
+//  Cost while off: one predictable branch.
+// ---------------------------------------------------------------------------
+struct FaalTraceInput
+{
+	float dt = 0.f;
+	float gyroX = 0.f, gyroY = 0.f, gyroZ = 0.f;   // values handed to faal_filter()
+	float rawX = 0.f, rawY = 0.f, rawZ = 0.f;       // calibrated gyro, before the gyro-space transform
+	float gravX = 0.f, gravY = 0.f, gravZ = 0.f;    // gravity estimate, same frame
+	float quatW = 1.f, quatX = 0.f, quatY = 0.f, quatZ = 0.f;
+	// What actually left the filter towards the consumer:
+	//   2D path  -> the filtered (yaw, pitch) that feeds sensitivity
+	//   PS_MOTION -> the (x, y, z) forwarded to the virtual controller
+	float outX = 0.f, outY = 0.f, outZ = 0.f;
+};

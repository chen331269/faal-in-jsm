diff --git a/JoyShockMapper/src/faal_filter.cpp b/JoyShockMapper/src/faal_filter.cpp
new file mode 100644
index 0000000..04ec305
--- /dev/null
+++ b/JoyShockMapper/src/faal_filter.cpp
@@ -0,0 +1,473 @@
+#include "faal_filter.h"
+#include <math.h>
+#include <stdio.h>
+#include <atomic>
+
+static FaalParams g_params;
+
+static AxisState s_faal_stateX;
+static AxisState s_faal_stateY;
+static AxisState s_faal_stateZ;
+static bool s_faal_firstFrame = true;
+
+// ResetFaalFilter() is called from the command thread while the input polling
+// thread may be inside faal_filter(). Touching the state from both sides is a
+// data race, so a reset is only *requested* here and applied by the next call to
+// faal_filter(), which always runs on the polling thread.
+static std::atomic<bool> s_faal_resetRequested{ false };
+
+static float s_smoothDirX = 0.0f;
+static float s_smoothDirY = 0.0f;
+static float s_smoothDirZ = 0.0f;
+
+// ---------------------------------------------------------------------------
+//  Internal constants
+// ---------------------------------------------------------------------------
+static const float kDtMin = 1e-3f;            // 1 ms
+static const float kDtMax = 0.05f;            // 50 ms
+static const float kDropSpeedRefHz = 1000.0f; // 1000Hz reference for dropSpeed/signChange
+
+static inline float faal_abs(float v)
+{
+	return (v < 0.0f) ? -v : v;
+}
+
+static inline float faal_clamp(float v, float lo, float hi)
+{
+	if (v < lo)
+		return lo;
+	if (v > hi)
+		return hi;
+	return v;
+}
+
+// ---------------------------------------------------------------------------
+//  One Euro Filter (passthrough derivative, alpha_d = 1)
+// ---------------------------------------------------------------------------
+static float oneEuroFilter(float x, float dt, float fc_min, float beta,
+  float& x_prev, float& dx_prev)
+{
+	float dx = (x - x_prev) / dt;
+	dx_prev = dx;
+
+	float fc = fc_min + beta * faal_abs(dx_prev);
+	float tau = 1.0f / (2.0f * 3.14159265f * fc + 0.00001f);
+	float alpha = 1.0f / (1.0f + tau / dt);
+
+	float x_out = alpha * x + (1.0f - alpha) * x_prev;
+	x_prev = x_out;
+	return x_out;
+}
+
+// Same filter, but the cutoff is decided by the caller. The tier split needs the
+// speed of the *whole* vector, so the per-axis function must not work it out from
+// its own input — two axes with different cutoffs would rotate the vector.
+static float oneEuroWithCutoff(float x, float dt, float fc, float& x_prev)
+{
+	float tau = 1.0f / (2.0f * 3.14159265f * fc + 0.00001f);
+	float alpha = 1.0f / (1.0f + tau / dt);
+	float x_out = alpha * x + (1.0f - alpha) * x_prev;
+	x_prev = x_out;
+	return x_out;
+}
+
+// ---------------------------------------------------------------------------
+//  Per-axis processing
+// ---------------------------------------------------------------------------
+
+// Tier weight for the soft-tiered split: 0 = fully smoothed, 1 = fully direct.
+// Derived from the whole vector's speed so both axes split identically.
+static float smoothTierWeight(float speed)
+{
+	float top = g_params.smoothThreshold;
+	if (top <= 0.0f)
+		return 1.0f; // threshold 0 means "no smoothing at all": everything direct
+	float bottom = top * 0.5f;
+	if (speed <= bottom)
+		return 0.0f;
+	if (speed >= top)
+		return 1.0f;
+	return (speed - bottom) / (top - bottom);
+}
+static float doFilter(AxisState& st, float v, float dt, bool forceSuppress,
+  float tierWeight, float vectorSpeed)
+{
+	float absV = faal_abs(v);
+
+	// ---- 1) dropSpeed (1000 Hz normalized) ------------------------------
+	float dropSpeed = 0.0f;
+	if (st.peakValue > g_params.peakMinTrigger)
+	{
+		float deltaAbsV = st.prevAbsV - absV;
+		if (deltaAbsV > 0.0f)
+		{
+			dropSpeed = deltaAbsV / (dt * kDropSpeedRefHz) /
+			  (st.peakValue + 0.001f);
+		}
+	}
+
+	// ---- 2) Frame-rate independent hysteresis coefficients --------------
+	float riseFactor = 1.0f - expf(-dt / g_params.hystRiseTime);
+	float fastFallFactor = 1.0f - expf(-dt / g_params.hystFallFastTime);
+	float slowFallFactor = 1.0f - expf(-dt / g_params.hystFallTime);
+
+	// ---- 3) Adaptive fall factor ----------------------------------------
+	// Use the PREVIOUS frame's suppressHyst as the adaptive signal.
+	// Strong suppression (flick just ended) → slow fall (sticky).
+	// Weak suppression (normal tracking)    → fast fall (responsive).
+	// No thresholds. State drives itself.
+	float fallFactor = fastFallFactor +
+	  (slowFallFactor - fastFallFactor) * st.suppressHyst;
+	fallFactor = faal_clamp(fallFactor, 0.0f, 1.0f);
+
+	// ---- 4) Peak tracking (independent peakDecayTime) -------------------
+	st.prevPeakValue = st.peakValue;
+	if (absV > st.peakValue)
+		st.peakValue = absV;
+	else
+		st.peakValue *= expf(-dt / g_params.peakDecayTime);
+
+	// ---- 5) Drift hold --------------------------------------------------
+	if (g_params.enableDriftHold && g_params.driftHoldTimeSec > 0.0f)
+	{
+		if (absV < g_params.driftThreshold)
+			st.stillTimeSec += dt;
+		else
+			st.stillTimeSec = 0.0f;
+
+		if (st.stillTimeSec >= g_params.driftHoldTimeSec)
+		{
+			st.prevOut = st.peakValue = st.prevPeakValue = st.prevAbsV = st.prevV = 0.0f;
+			st.suppressHyst = 0.0f;
+			st.freezeRemainingSec = 0.0f;
+			st.stillTimeSec = 0.0f;
+			st.oneEuroPrev = 0.0f;
+			st.oneEuroDeriv = 0.0f;
+			return 0.0f;
+		}
+	}
+
+	// ---- 6) Raw suppression ---------------------------------------------
+	float rawSuppress = 0.0f;
+	if (st.peakValue > g_params.peakMinTrigger)
+	{
+		float raw = faal_clamp(dropSpeed * g_params.dropSensitivity, 0.0f, 1.0f);
+		rawSuppress = powf(raw, g_params.dropCurve);
+	}
+
+	// ---- 7) Single-frame zero-crossing override -------------------------
+	if (g_params.signChangeThr > 0.0f && st.peakValue > g_params.peakMinTrigger)
+	{
+		bool bothNonZero = (st.prevV != 0.0f) && (v != 0.0f);
+		bool signedFlip = bothNonZero && ((st.prevV < 0.0f) != (v < 0.0f));
+		float refDeltaV = faal_abs(v - st.prevV) / (dt * kDropSpeedRefHz);
+		bool magnitudeJump = refDeltaV > g_params.signChangeThr;
+		if (signedFlip && magnitudeJump)
+		{
+			rawSuppress = 1.0f;
+			st.suppressHyst = 1.0f;
+		}
+	}
+
+	// ---- 8) External override (vector reversal) -------------------------
+	if (forceSuppress)
+	{
+		rawSuppress = 1.0f;
+		st.suppressHyst = 1.0f;
+	}
+
+
+
+	// ---- 9) Hysteresis (self-adaptive fall) -----------------------------
+	if (rawSuppress > st.suppressHyst)
+	{
+		st.suppressHyst = st.suppressHyst * (1.0f - riseFactor) +
+		  rawSuppress * riseFactor;
+	}
+	else
+	{
+		st.suppressHyst = st.suppressHyst * (1.0f - fallFactor) +
+		  rawSuppress * fallFactor;
+	}
+	st.suppressHyst = faal_clamp(st.suppressHyst, 0.0f, 1.0f);
+
+	st.prevAbsV = absV;
+
+	// ---- 10) Tiered One Euro smoothing ----------------------------------
+	// The input is split by magnitude, not the output blended: whatever goes into
+	// the filter is eventually consumed, so total displacement is preserved and a
+	// big movement never loads up the filter's state. Above the threshold the
+	// weight is 1 and the filter is fed zero, which lets it drain.
+	float directPart = v * tierWeight;
+	float smoothed = oneEuroWithCutoff(v * (1.0f - tierWeight), dt,
+	  g_params.oneEuroFcMin + g_params.oneEuroBeta * vectorSpeed,
+	  st.oneEuroPrev);
+	float out = directPart + smoothed;
+
+	// ---- 11) Apply suppression ------------------------------------------
+	out *= (1.0f - st.suppressHyst);
+
+	// ---- 12) Freeze window ----------------------------------------------
+	if (g_params.freezeDurationSec > 0.0f)
+	{
+		if (st.suppressHyst > g_params.suppressThr)
+			st.freezeRemainingSec = g_params.freezeDurationSec;
+		if (st.freezeRemainingSec > 0.0f)
+		{
+			out *= g_params.freezeOutMul;
+			st.freezeRemainingSec -= dt;
+			if (st.freezeRemainingSec < 0.0f)
+				st.freezeRemainingSec = 0.0f;
+		}
+	}
+
+	st.prevOut = out;
+	st.prevV = v;
+	return out;
+}
+
+// ---------------------------------------------------------------------------
+//  Vector reversal detection
+// ---------------------------------------------------------------------------
+static bool checkVectorReversal3D(float curX, float curY, float curZ,
+  float prevX, float prevY, float prevZ)
+{
+	if (g_params.enableVectorReversal <= 0.5f)
+		return false;
+
+	float prevLen2 = prevX * prevX + prevY * prevY + prevZ * prevZ;
+	float curLen2 = curX * curX + curY * curY + curZ * curZ;
+	if (prevLen2 < 1e-12f || curLen2 < 1e-12f)
+		return false;
+
+	float prevLen = sqrtf(prevLen2);
+	float curLen = sqrtf(curLen2);
+	float dot = prevX * curX + prevY * curY + prevZ * curZ;
+	float cosTheta = faal_clamp(dot / (prevLen * curLen), -1.0f, 1.0f);
+
+	if (cosTheta >= cosf(g_params.dirChangeAngleRad))
+		return false;
+
+	float sinTheta = sqrtf(faal_clamp(1.0f - cosTheta * cosTheta, 0.0f, 1.0f));
+	return sinTheta > g_params.dirChangeMagRatio;
+}
+
+// ---------------------------------------------------------------------------
+//  Two-axis API (independent, does not touch Z state)
+// ---------------------------------------------------------------------------
+void faal_filter(float& outX, float& outY, float dt)
+{
+	dt = faal_clamp(dt, kDtMin, kDtMax);
+
+	if (s_faal_firstFrame || s_faal_resetRequested.exchange(false))
+	{
+		s_faal_stateX.init();
+		s_faal_stateY.init();
+		s_faal_firstFrame = false;
+		s_smoothDirX = s_smoothDirY = 0.0f;
+	}
+
+	float alpha = 1.0f - expf(-dt / g_params.smoothTimeSec);
+
+	bool forceSuppress = false;
+	if (g_params.enableVectorReversal > 0.5f)
+	{
+		float prevLen2 = s_smoothDirX * s_smoothDirX + s_smoothDirY * s_smoothDirY;
+		float curLen2 = outX * outX + outY * outY;
+		if (prevLen2 > 1e-12f && curLen2 > 1e-12f)
+		{
+			float prevLen = sqrtf(prevLen2);
+			float curLen = sqrtf(curLen2);
+			float dot = s_smoothDirX * outX + s_smoothDirY * outY;
+			float cosTheta = faal_clamp(dot / (prevLen * curLen), -1.0f, 1.0f);
+			if (cosTheta < cosf(g_params.dirChangeAngleRad))
+			{
+				float sinTheta = sqrtf(faal_clamp(1.0f - cosTheta * cosTheta, 0.0f, 1.0f));
+				forceSuppress = sinTheta > g_params.dirChangeMagRatio;
+			}
+		}
+	}
+
+	// Compare first, then absorb: updating the reference before the comparison pulls
+	// it towards the current direction and under-reads the turn by (1 - alpha).
+	s_smoothDirX += alpha * (outX - s_smoothDirX);
+	s_smoothDirY += alpha * (outY - s_smoothDirY);
+
+	{
+		float speed2 = sqrtf(outX * outX + outY * outY);
+		float w = smoothTierWeight(speed2);
+		outX = doFilter(s_faal_stateX, outX, dt, forceSuppress, w, speed2);
+		outY = doFilter(s_faal_stateY, outY, dt, forceSuppress, w, speed2);
+	}
+}
+
+// ---------------------------------------------------------------------------
+//  Three-axis API
+// ---------------------------------------------------------------------------
+void faal_filter(float& outX, float& outY, float& outZ, float dt)
+{
+	dt = faal_clamp(dt, kDtMin, kDtMax);
+
+	if (s_faal_firstFrame || s_faal_resetRequested.exchange(false))
+	{
+		s_faal_stateX.init();
+		s_faal_stateY.init();
+		s_faal_stateZ.init();
+		s_faal_firstFrame = false;
+		s_smoothDirX = s_smoothDirY = s_smoothDirZ = 0.0f;
+	}
+
+	float alpha = 1.0f - expf(-dt / g_params.smoothTimeSec);
+
+	bool forceSuppress = checkVectorReversal3D(
+	  outX, outY, outZ,
+	  s_smoothDirX, s_smoothDirY, s_smoothDirZ);
+
+	// Compare first, then absorb (see the two-axis entry point).
+	s_smoothDirX += alpha * (outX - s_smoothDirX);
+	s_smoothDirY += alpha * (outY - s_smoothDirY);
+	s_smoothDirZ += alpha * (outZ - s_smoothDirZ);
+
+	{
+		float speed3 = sqrtf(outX * outX + outY * outY + outZ * outZ);
+		float w = smoothTierWeight(speed3);
+		outX = doFilter(s_faal_stateX, outX, dt, forceSuppress, w, speed3);
+		outY = doFilter(s_faal_stateY, outY, dt, forceSuppress, w, speed3);
+		outZ = doFilter(s_faal_stateZ, outZ, dt, forceSuppress, w, speed3);
+	}
+}
+
+void ResetFaalFilter()
+{
+	// Applied by the next faal_filter() call (polling thread) — see the comment
+	// on s_faal_resetRequested.
+	s_faal_resetRequested.store(true, std::memory_order_release);
+}
+
+const FaalParams& GetFaalParams()
+{
+	return g_params;
+}
+
+void SetFaalParams(const FaalParams& p)
+{
+	g_params = p;
+	// DERIVED: fast fall = 0.446 × fall time (from original 0.029 / 0.065)
+	g_params.hystFallFastTime = g_params.hystFallTime * 0.446f;
+}
+
+// ---------------------------------------------------------------------------
+//  Per-frame trace
+// ---------------------------------------------------------------------------
+struct FaalTraceSample
+{
+	float dt, gx, gy, gz;
+	float signChangeThr, freezeDurationSec, enableVectorReversal, smoothTimeSec;
+	// v2: everything needed to re-derive the 2D values in any gyro space offline.
+	float rawX, rawY, rawZ;       // calibrated gyro before the space transform
+	float gravX, gravY, gravZ;    // gravity estimate that frame
+	float quatW, quatX, quatY, quatZ;
+	float outX, outY, outZ;       // what actually left the filter
+};
+
+static const size_t kFaalTraceCapacity = 150000; // ≈150 s at 1000 Hz, ≈10.2 MB
+static FaalTraceSample* s_traceSamples = nullptr;
+// Written on the polling thread, read/replaced on the command thread.
+static std::atomic<size_t> s_traceCount{ 0 };
+static std::atomic<bool> s_traceRecording{ false };
+
+void FaalTraceStart()
+{
+	if (s_traceRecording.load(std::memory_order_acquire))
+		return; // already recording: keep what we have
+	if (s_traceSamples == nullptr)
+		s_traceSamples = new FaalTraceSample[kFaalTraceCapacity];
+	s_traceCount.store(0, std::memory_order_relaxed);
+	s_traceRecording.store(true, std::memory_order_release);
+}
+
+bool FaalTraceIsRecording()
+{
+	return s_traceRecording.load(std::memory_order_acquire);
+}
+
+unsigned long long FaalTraceRecordedFrames()
+{
+	return (unsigned long long)s_traceCount.load(std::memory_order_acquire);
+}
+
+void FaalTraceRecord(const FaalTraceInput& in, const FaalParams& applied)
+{
+	if (!s_traceRecording.load(std::memory_order_relaxed))
+		return;
+	const size_t index = s_traceCount.load(std::memory_order_relaxed);
+	if (index >= kFaalTraceCapacity)
+		return;
+	FaalTraceSample& s = s_traceSamples[index];
+	s.dt = in.dt;
+	s.gx = in.gyroX;
+	s.gy = in.gyroY;
+	s.gz = in.gyroZ;
+	s.signChangeThr = applied.signChangeThr;
+	s.freezeDurationSec = applied.freezeDurationSec;
+	s.enableVectorReversal = applied.enableVectorReversal;
+	s.smoothTimeSec = applied.smoothTimeSec;
+	s.rawX = in.rawX;
+	s.rawY = in.rawY;
+	s.rawZ = in.rawZ;
+	s.gravX = in.gravX;
+	s.gravY = in.gravY;
+	s.gravZ = in.gravZ;
+	s.quatW = in.quatW;
+	s.quatX = in.quatX;
+	s.quatY = in.quatY;
+	s.quatZ = in.quatZ;
+	s.outX = in.outX;
+	s.outY = in.outY;
+	s.outZ = in.outZ;
+	s_traceCount.store(index + 1, std::memory_order_release);
+}
+
+unsigned long long FaalTraceStopAndWrite(const char* path)
+{
+	// Stop first: the polling thread checks this flag before every write, so no
+	// new samples land after this point (the buffer itself is never freed, so a
+	// sample racing with us is at worst not included).
+	s_traceRecording.store(false, std::memory_order_release);
+	if (s_traceSamples == nullptr)
+		return 0;
+	const size_t count = s_traceCount.load(std::memory_order_acquire);
+	if (count == 0)
+		return 0;
+
+	FILE* f = fopen(path, "wb");
+	if (f == nullptr)
+		return 0;
+
+	const FaalParams& p = g_params;
+	fprintf(f, "# faal-trace v2\n");
+	fprintf(f, "# rise=%g fall=%g peakdecay=%g drift=%g fcemin=%g beta=%g magratio=%g angle=%g "
+	           "drop=%g curve=%g peakmin=%g suppressThr=%g freezeMul=%g driftthr=%g drift_on=%d\n",
+	  p.hystRiseTime, p.hystFallTime, p.peakDecayTime, p.driftHoldTimeSec,
+	  p.oneEuroFcMin, p.oneEuroBeta, p.dirChangeMagRatio, p.dirChangeAngleRad,
+	  p.dropSensitivity, p.dropCurve, p.peakMinTrigger, p.suppressThr,
+	  p.freezeOutMul, p.driftThreshold, p.enableDriftHold ? 1 : 0);
+	fprintf(f, "dt,gx,gy,gz,sign_thr,freeze_dur,rev_on,smooth_time,"
+	           "raw_x,raw_y,raw_z,grav_x,grav_y,grav_z,quat_w,quat_x,quat_y,quat_z,out_x,out_y,out_z\n");
+
+	const size_t n = count;
+	for (size_t i = 0; i < n; ++i)
+	{
+		const FaalTraceSample& s = s_traceSamples[i];
+		fprintf(f, "%.6f,%.4f,%.4f,%.4f,%.4f,%.4f,%.1f,%.6f,"
+		           "%.4f,%.4f,%.4f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.4f,%.4f,%.4f\n",
+		  s.dt, s.gx, s.gy, s.gz, s.signChangeThr, s.freezeDurationSec,
+		  s.enableVectorReversal, s.smoothTimeSec,
+		  s.rawX, s.rawY, s.rawZ, s.gravX, s.gravY, s.gravZ,
+		  s.quatW, s.quatX, s.quatY, s.quatZ, s.outX, s.outY, s.outZ);
+	}
+	fclose(f);
+
+	s_traceCount.store(0, std::memory_order_relaxed);
+	return (unsigned long long)n;
+}
